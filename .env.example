# ==============================================================================
# COFREADMIN - ENVIRONMENT VARIABLES (PUBLIC / OPEN-SOURCE TEMPLATE)
# ==============================================================================
# Copy this template to .env for local development: cp .env.example .env
# NEVER commit real private keys, passwords, or production secrets into this file!
# For production (Firebase App Hosting), configure these variables in the App Hosting settings panel.
# ==============================================================================

# Application URL (optional, used for OAuth callbacks and absolute links)
APP_URL=http://localhost:3000

# ==============================================================================
# CIRCLE PAYMASTER PERMISSIONLESS (BASE L2)
# ==============================================================================
# The Circle Paymaster on Base enables gasless or USDC-sponsored transactions.
# Optional Circle API key for supplementary RPC / webhook services:
CIRCLE_API_KEY=

# ==============================================================================
# WALLET & FEE CONFIGURATION (BASE L2)
# ==============================================================================
# DEVELOPER / TREASURY WALLET (APPLICATION PROTOCOL FEE)
# Public EVM address for collecting application fees (0.2% with a $0.05 USDC minimum)
DEV_FEE_RECIPIENT_ADDRESS=0xD4875cCF87Efb7DDD8dF7787aE4094d5CD2C71De
VITE_DEV_FEE_RECIPIENT_ADDRESS=0xD4875cCF87Efb7DDD8dF7787aE4094d5CD2C71De

# OFFICIAL RELAYER WALLET (ETH GAS REIMBURSEMENT ON BASE NETWORK)
# Public EVM address of the gas relayer
EXPECTED_GAS_RELAYER=0x31b7BafB5Bf4ab3D892610Ae7C9cA45BdBc45233
VITE_EXPECTED_GAS_RELAYER=0x31b7BafB5Bf4ab3D892610Ae7C9cA45BdBc45233

# RELAYER PRIVATE KEY (OPTIONAL SERVER-SIDE ONLY TO SPONSOR DISPATCH GAS)
# SECURITY WARNING: Never commit private keys to GitHub! Use strictly on your secure server.
RELAYER_PRIVATE_KEY=

# ==============================================================================
# FIREBASE CONFIGURATION (FIRESTORE & AUTHENTICATION)
# ==============================================================================
# To connect your own Firebase project:
# 1. Create a project at https://console.firebase.google.com/
# 2. Register a Web App and enable Cloud Firestore and Authentication
# 3. Enter your project's credentials below:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
FIREBASE_AUTH_DOMAIN=

# ==============================================================================
# DISCORD OAUTH (LOGIN VIA DISCORD - OPTIONAL)
# ==============================================================================
# Obtain credentials from https://discord.com/developers/applications > Your App > OAuth2
# Add the Redirect URI: https://<your-domain>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_STATE_SECRET=


# ==============================================================================
# SUPPORT, FEEDBACK & CONTACT
# ==============================================================================
VITE_SUPPORT_EMAIL=cofreadminwallet@gmail.com
VITE_FEEDBACK_URL=https://forms.gle/MBpyniv5zf795wi97

# ==============================================================================
# ANALYTICS & MONETIZATION (OPTIONAL)
# ==============================================================================
VITE_GA_MEASUREMENT_ID=
VITE_GA_STREAM_ID=
VITE_HYPELAB_PROPERTY_SLUG=
VITE_HYPELAB_CARD_BANNER_PLACEMENT=
